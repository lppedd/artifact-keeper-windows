# Artifact Keeper Configuration
# Copy this file to C:\ProgramData\ArtifactKeeper\config\.env and edit as needed.

# Required: PostgreSQL connection string
DATABASE_URL=postgresql://registry:changeme@localhost:5432/artifact_registry

# Required: Secret key for JWT token signing (minimum 32 characters)
# Generate with: [System.Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=

# HTTP server bind address
BIND_ADDRESS=0.0.0.0:8080

# Artifact storage path
STORAGE_PATH=C:\ProgramData\ArtifactKeeper\artifacts

# Logging level (error, warn, info, debug, trace)
RUST_LOG=info

# Optional: Meilisearch for full-text search
# MEILISEARCH_URL=http://localhost:7700
# MEILISEARCH_API_KEY=

# Optional: Security scanning
# TRIVY_URL=http://localhost:8090
